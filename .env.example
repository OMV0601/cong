# Copy to .env.local and fill in. Never commit .env.local.
VITE_SUPABASE_URL=https://<project>.supabase.co

# The PUBLISHABLE (anon) key only. It ships in the frontend bundle by design —
# Row-Level Security is what protects the data, not this key.
# The secret / service_role key must NEVER appear here or in the frontend.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Public half of the VAPID keypair. Generate with: npm run vapid
VITE_VAPID_PUBLIC_KEY=
